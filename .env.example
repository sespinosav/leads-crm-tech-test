# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=leads_db

# OpenAI (optional — if missing the AI module falls back to a deterministic mock)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth — simple API key required on protected endpoints (leave empty to disable)
API_KEY=

# Rate limiting (requests per minute per IP)
THROTTLE_TTL=60
THROTTLE_LIMIT=60
